+using System.Collections;
 using UnityEngine;
 using System.Collections.Generic;
 using AnimationOrTween;
@@ -254,11 +255,11 @@ public class UIPlayAnimation : MonoBehaviour
 	{
 		if (target)
 		{
-			// if (onlyIfDifferent)
-			// {
-			// 	if (mActivated == forward) return;
-			// 	mActivated = forward;
-			// }
+			if (onlyIfDifferent)
+			{
+				if (mActivated == forward) return;
+				mActivated = forward;
+			}
 			//
 			// if (clearSelection && UICamera.selectedObject == gameObject)
 			// 	UICamera.selectedObject = null;
@@ -278,21 +279,29 @@ public class UIPlayAnimation : MonoBehaviour
 			
 			if (string.IsNullOrEmpty(clipName))
 				return;
+
+			var direction = forward ? playDirection : (Direction)(-(int)playDirection);
 			
 			if (Time.timeScale == 0f)
 			{
 				// do "all this crap" 🤣 but it's needed otherwise the animations break when timeScale == 0f
-				ActiveAnimation.Play(target, clipName, forward ? playDirection : (Direction)(-(int)playDirection), ifDisabledOnPlay, disableWhenFinished);
+				ActiveAnimation.Play(target, clipName, direction, ifDisabledOnPlay, disableWhenFinished);
