+	private IEnumerator WaitForFinish()
+	{
+		var clipState = target[clipName];
+		if (clipState == null)
+			yield break;
+
+		while (target.IsPlaying(clipName))
+			yield return null;
+		
+		clipState.speed = 1f;
+		clipState.time = 0f;
